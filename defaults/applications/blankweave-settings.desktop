[Desktop Entry]
Type=Application
Name=Blankweave Settings
Comment=Personalize your desktop and explore upcoming system settings
Exec=sh -c "exec \\"\\$HOME/.local/bin/blankweave\\" settings"
Icon=blankweave-settings
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=preferences;theme;appearance;display;power;keyboard;backup;
StartupNotify=false

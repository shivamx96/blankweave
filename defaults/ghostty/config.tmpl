# Managed by Blankweave; edit ~/.config/blankweave/overrides/ghostty.conf.
theme = light:{{modes.light.ghostty}},dark:{{modes.dark.ghostty}}
font-family = JetBrains Mono Nerd Font
font-size = 11
cursor-style = block
window-padding-x = 8
window-padding-y = 8
window-decoration = none
shell-integration = zsh
confirm-close-surface = true
mouse-hide-while-typing = true

keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = home=text:\x01
keybind = end=text:\x05

config-file = ?~/.config/blankweave/overrides/ghostty.conf

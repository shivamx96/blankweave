# Rendered by theme-apply.sh from the active theme's "lock" block; edit the
# template or the theme, not the output. The lock screen sits on the wallpaper,
# so it carries its own text and accent values rather than the shell palette's.
$lock_canvas = {{colors.canvas}}
$panel_surface = {{lock.panelSurface}}
$panel_border = {{lock.panelBorder}}
$panel_shadow = {{lock.panelShadow}}
$hairline = {{lock.hairline}}
$input_surface = {{lock.inputSurface}}
$input_border = {{colors.outline}} {{lock.accent}} {{lock.accentBright}} 90deg
$placeholder = <span foreground="#{{lock.placeholder:rgb}}">Password</span>
$text = {{lock.text}}
$text_muted = {{lock.textMuted}}
$text_shadow = {{lock.textShadow}}
$accent = {{lock.accent}}
$accent_bright = {{lock.accentBright}}
$success = {{colors.success}}
$warning = {{colors.warning}}
$critical = {{colors.critical}}
$background_contrast = {{lock.contrast}}
$background_brightness = {{lock.brightness}}
$background_vibrancy = {{lock.vibrancy}}

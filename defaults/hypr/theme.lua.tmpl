-- Rendered by theme-apply.sh into ~/.config/blankweave/theme.lua from the active
-- theme. hyprland.lua loads it with pcall and falls back to its own defaults,
-- so a missing or broken file never keeps the compositor from starting.
return {
    active_border = { "{{colors.accent}}", "{{colors.accentBright}}" },
    inactive_border = "{{colors.outline}}",
    cursor_theme = "{{cursorTheme}}",
}

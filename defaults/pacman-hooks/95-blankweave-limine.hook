[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = limine

[Action]
Description = Refreshing Blankweave Limine boot entries...
When = PostTransaction
Exec = /usr/local/lib/blankweave/configure-limine

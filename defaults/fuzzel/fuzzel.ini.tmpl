# Rendered by theme-apply.sh from the active theme; edit the template, not the output.
[main]
font=Atkinson Hyperlegible Next:size=16, JetBrains Mono Nerd Font:size=16
prompt="󰍉  "
icon-theme={{iconTheme}}
icons-enabled=yes
anchor=center
width=55
lines=7
horizontal-pad=28
vertical-pad=20
inner-pad=16
line-height=32
letter-spacing=0.5
layer=overlay
exit-on-keyboard-focus-loss=yes
match-mode=fzf

[colors]
background={{colors.panelSurface}}
text={{colors.text}}
prompt={{colors.textMuted}}
input={{colors.text}}
match={{colors.accentBright}}
selection={{colors.accentSurface}}
selection-text={{colors.text}}
selection-match={{colors.accentBright}}
border={{colors.outline}}
counter={{colors.textMuted}}

[border]
width=1
radius=20

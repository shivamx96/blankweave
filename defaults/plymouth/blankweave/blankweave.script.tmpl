// Blankweave Plymouth Theme
// Rendered by theme-apply.sh from the active theme: the dark-mode canvas
// behind a centred logo and a smooth progress bar in the accent.

// --- Background ---
Window.SetBackgroundTopColor({{modes.dark.colors.canvas:plymouth}});
Window.SetBackgroundBottomColor({{modes.dark.colors.canvas:plymouth}});

// --- Logo ---
logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.GetHeight() / 2);
logo_sprite.SetOpacity(1);

// --- Progress bar ---
progress_box = Image("progress_box.png");
progress_bar = Image("progress_bar.png");

progress_box_sprite = Sprite(progress_box);
progress_box_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - progress_box.GetWidth() / 2);
progress_box_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + logo.GetHeight() / 2 + 40);
progress_box_sprite.SetOpacity(1);

progress_bar_sprite = Sprite();
progress_bar_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - progress_bar.GetWidth() / 2);
progress_bar_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + logo.GetHeight() / 2 + 40);
progress_bar_sprite.SetOpacity(1);

// --- Fake progress animation ---
global.fake_progress = 0;
global.fake_progress_limit = 0.7;
global.fake_progress_duration = 15;
global.max_progress = 0;
global.frame = 0;

fun refresh_callback() {
    global.frame++;

    // Fake progress: ease-out quadratic over fake_progress_duration seconds (~50 fps)
    time_ratio = global.frame / (global.fake_progress_duration * 50);
    if (time_ratio > 1) time_ratio = 1;
    eased = 1 - ((1 - time_ratio) * (1 - time_ratio));
    global.fake_progress = eased * global.fake_progress_limit;

    // Use whichever is higher: fake or real progress
    progress = global.max_progress;
    if (global.fake_progress > progress)
        progress = global.fake_progress;

    // Never go backwards
    if (progress > global.max_progress)
        global.max_progress = progress;

    // Crop the progress bar image to show current progress
    bar_width = progress_bar.GetWidth() * global.max_progress;
    if (bar_width > 0) {
        cropped = progress_bar.Scale(bar_width, progress_bar.GetHeight());
        progress_bar_sprite.SetImage(cropped);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback(duration, progress) {
    if (progress > global.max_progress)
        global.max_progress = progress;
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

// --- Password prompt ---
// systemd-ask-password and mkinitcpio's encrypt hook hand the prompt and the
// current number of typed characters to Plymouth. A script theme must render
// that state itself; without these callbacks an encrypted root waits behind an
// apparently frozen splash.
global.display_mode = "normal";
global.password_bullet_image = Image.Text("*", {{modes.dark.colors.accentBright:plymouth}});

password_prompt_sprite = Sprite();
password_hint_image = Image.Text("Type passphrase and press Enter", {{modes.dark.colors.textMuted:plymouth}});
password_hint_sprite = Sprite(password_hint_image);
password_hint_sprite.SetOpacity(0);

fun set_progress_opacity(opacity) {
    progress_box_sprite.SetOpacity(opacity);
    progress_bar_sprite.SetOpacity(opacity);
}

fun hide_password_dialog() {
    password_prompt_sprite.SetOpacity(0);
    password_hint_sprite.SetOpacity(0);
    for (index = 0; global.password_bullet[index]; index++)
        global.password_bullet[index].sprite.SetOpacity(0);
}

fun display_normal_callback() {
    global.display_mode = "normal";
    hide_password_dialog();
    set_progress_opacity(1);
}

fun display_password_callback(prompt, bullets) {
    global.display_mode = "password";
    set_progress_opacity(0);

    if (prompt == "")
        prompt = "Unlock encrypted disk";

    prompt_image = Image.Text(prompt, {{modes.dark.colors.text:plymouth}});
    password_prompt_sprite.SetImage(prompt_image);
    dialog_y = Window.GetY() + Window.GetHeight() / 2 + logo.GetHeight() / 2 + 20;
    password_prompt_sprite.SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - prompt_image.GetWidth() / 2,
        dialog_y,
        10000
    );
    password_prompt_sprite.SetOpacity(1);

    password_hint_sprite.SetPosition(
        Window.GetX() + Window.GetWidth() / 2 - password_hint_image.GetWidth() / 2,
        dialog_y + prompt_image.GetHeight() + 6,
        10000
    );
    password_hint_sprite.SetOpacity(1);

    bullet_spacing = global.password_bullet_image.GetWidth() + 8;
    bullet_x = Window.GetX() + Window.GetWidth() / 2 - bullets * bullet_spacing / 2;
    bullet_y = dialog_y + prompt_image.GetHeight() + password_hint_image.GetHeight() + 14;
    for (index = 0; global.password_bullet[index] || index < bullets; index++) {
        if (!global.password_bullet[index]) {
            global.password_bullet[index].sprite = Sprite(global.password_bullet_image);
        }
        global.password_bullet[index].sprite.SetPosition(
            bullet_x + index * bullet_spacing,
            bullet_y,
            10001
        );
        if (index < bullets)
            global.password_bullet[index].sprite.SetOpacity(1);
        else
            global.password_bullet[index].sprite.SetOpacity(0);
    }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

// Keep important boot messages visible even with quiet boot enabled. Shutdown,
// reboot, and halt messages stay hidden so system status text cannot punch
// through the splash.
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + 10, Window.GetY() + 10, 10000);

fun display_message_callback(message) {
    mode = Plymouth.GetMode();
    if (mode == "boot" || mode == "resume") {
        message_image = Image.Text(message, {{modes.dark.colors.textMuted:plymouth}});
        message_sprite.SetImage(message_image);
        message_sprite.SetOpacity(1);
    } else {
        message_sprite.SetOpacity(0);
    }
}

fun hide_message_callback(message) {
    message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

fun quit_callback() {
    logo_sprite.SetOpacity(1);
}

Plymouth.SetQuitFunction(quit_callback);

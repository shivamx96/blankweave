# Rendered by theme-apply.sh from the active theme; edit the template, not the output.
[global]
# Compact notification cards aligned with the native Blankweave shell.
monitor = 0
# follow overrides monitor; Wayland delegates output choice to Hyprland.
follow = keyboard
width = 420
height = (0, 180)
origin = top-right
offset = (8, 8)
notification_limit = 4
layer = overlay

sort = update
indicate_hidden = true
separator_height = 0
gap_size = 6
padding = 12
horizontal_padding = 14
text_icon_padding = 12
frame_width = {{design.shape.borderWidth}}
frame_color = "{{colors.outlineStrong}}"
separator_color = frame

background = "{{colors.panelSurface:rgb}}"
foreground = "{{colors.text}}"
font = Atkinson Hyperlegible Next 11
line_height = 3
format = "<span size='small' foreground='{{colors.textMuted}}'>%a</span>\n<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
# Native Wayland idle notifications keep non-transient alerts until activity resumes.
idle_threshold = 120s
ellipsize = end
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = true

corner_radius = {{design.shape.notificationRadius}}
icon_corner_radius = 0
corners = none
icon_corners = none

progress_bar = true
progress_bar_height = 3
progress_bar_frame_width = 0
progress_bar_min_width = 180
progress_bar_max_width = 390
progress_bar_corner_radius = 0
progress_bar_corners = none

enable_recursive_icon_lookup = true
icon_theme = "Papirus, Adwaita"
icon_position = left
min_icon_size = 28
max_icon_size = 40

sticky_history = false
history_length = 100
browser = /usr/bin/xdg-open

mouse_left_click = do_action, close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_current

[experimental]
pause_on_mouse_over = true

[urgency_low]
background = "{{colors.panelSurface:rgb}}"
foreground = "{{colors.textMuted}}"
frame_color = "{{colors.outline}}"
highlight = "{{colors.divider}}"
timeout = 4s
default_icon = dialog-information

[urgency_normal]
background = "{{colors.panelSurface:rgb}}"
foreground = "{{colors.text}}"
frame_color = "{{colors.outlineStrong}}"
highlight = "{{colors.accentBright}}"
timeout = 6s
default_icon = dialog-information

[urgency_critical]
# Manual DND and quiet hours pause at 100; equality passes in Dunst 1.13.
override_pause_level = 100
background = "{{colors.panelSurface:rgb}}"
foreground = "{{colors.text}}"
frame_color = "{{colors.critical}}"
highlight = "{{colors.critical}}"
timeout = 0
default_icon = dialog-warning

{
  "app_config": {
    "audio_config": {
      "audio": "pipewire"
    },
    "bluetooth_config": {
      "enabled": true
    },
    "fonts_config": {
      "fonts": [
        "noto-fonts",
        "noto-fonts-emoji"
      ]
    }
  },
  "archinstall-language": "English",
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "removable": false,
    "uki": false
  },
  "kernels": [
    "linux"
  ],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": [
    "base-devel",
    "git",
    "networkmanager",
    "openssh",
    "sudo"
  ],
  "pacman_config": {
    "color": true,
    "parallel_downloads": 10
  },
  "profile_config": {
    "gfx_driver": null,
    "greeter": null,
    "profile": {
      "custom_settings": {},
      "details": [],
      "main": "Minimal"
    }
  },
  "script": "guided",
  "services": [
    "NetworkManager"
  ],
  "swap": {
    "algorithm": "zstd",
    "enabled": true
  },
  "timezone": "Asia/Kolkata"
}

#!/usr/bin/env bash

set -euo pipefail

PROGRAM_NAME=blankweave
EXPECTED_REMOTES=(
    https://github.com/shivamx96/blankweave
    https://github.com/shivamx96/blankweave.git
    git@github.com:shivamx96/blankweave
    git@github.com:shivamx96/blankweave.git
)
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
BLANKWEAVE_DATA_DIR=$HOME/.local/share/blankweave
BLANKWEAVE_STATE_DIR=$STATE_HOME/blankweave
REPOSITORY_STATE=$BLANKWEAVE_STATE_DIR/repository
INSTALLED_REVISION_STATE=$BLANKWEAVE_STATE_DIR/installed-revision
INSTALLED_VERSION_STATE=$BLANKWEAVE_STATE_DIR/installed-version
INSTALLED_RELEASE_TAG_STATE=$BLANKWEAVE_STATE_DIR/installed-release-tag
RECOVERY_DIR=$BLANKWEAVE_STATE_DIR/recovery
RECOVERY_STATE=$RECOVERY_DIR/latest

die() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

script_repository() {
    local script_dir candidate

    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    candidate=$(cd -- "$script_dir/.." && pwd)
    if [[ -f "$candidate/install.sh" && -f "$candidate/VERSION" ]]; then
        printf '%s\n' "$candidate"
    fi
}

configured_repository() {
    local repository

    if repository=$(script_repository) && [[ -n "$repository" ]]; then
        printf '%s\n' "$repository"
    elif [[ -r "$REPOSITORY_STATE" ]]; then
        IFS= read -r repository < "$REPOSITORY_STATE"
        printf '%s\n' "$repository"
    else
        printf '%s\n' "$BLANKWEAVE_DATA_DIR/repository"
    fi
}

require_normal_user() {
    if (( EUID == 0 )); then
        die "run this command as your normal user; it will request sudo when required"
    fi
}

validate_repository() {
    local repository="$1"
    local remote

    [[ -d "$repository/.git" ]] || die "managed repository not found at $repository"
    [[ -f "$repository/install.sh" ]] || die "repository is missing install.sh"
    [[ -f "$repository/VERSION" ]] || die "repository is missing VERSION"
    [[ -f "$repository/MIN_ROLLBACK_VERSION" ]] \
        || die "repository is missing MIN_ROLLBACK_VERSION"
    [[ -r "$repository/scripts/release-version.sh" ]] \
        || die "repository is missing release-version.sh"
    [[ -x "$repository/bin/blankweave" ]] || die "repository is missing the blankweave command"

    remote=$(git -C "$repository" remote get-url origin 2>/dev/null) \
        || die "repository has no origin remote"
    local expected accepted=false
    for expected in "${EXPECTED_REMOTES[@]}"; do
        [[ "$remote" == "$expected" ]] && accepted=true
    done
    [[ "$accepted" == true ]] || die "refusing unexpected origin remote: $remote"
}

current_revision() {
    git -C "$1" rev-parse --short=12 HEAD 2>/dev/null || printf 'unknown\n'
}

read_version() {
    local source_repository version_file

    if source_repository=$(script_repository) && [[ -r "$source_repository/VERSION" ]]; then
        version_file=$source_repository/VERSION
    elif [[ -r "$BLANKWEAVE_DATA_DIR/VERSION" ]]; then
        version_file=$BLANKWEAVE_DATA_DIR/VERSION
    else
        printf 'unknown\n'
        return
    fi

    head -n 1 "$version_file"
}

apply_repository() {
    local repository="$1"

    require_normal_user
    validate_repository "$repository"
    "$repository/install.sh"
}

validate_revision() {
    [[ "$1" =~ ^[0-9a-f]{40,64}$ ]]
}

recovery_write() {
    local previous="$1"
    local previous_version="$2"
    local target="$3"
    local target_version="$4"
    local status="$5"
    local snapshot=${6:-}
    local staged

    validate_revision "$previous" || die "refusing invalid recovery revision: $previous"
    validate_revision "$target" || die "refusing invalid recovery revision: $target"
    blankweave_release_version_valid "$previous_version" \
        || die "refusing invalid recovery version: $previous_version"
    blankweave_release_version_valid "$target_version" \
        || die "refusing invalid recovery version: $target_version"
    [[ "$status" =~ ^[a-z-]+$ ]] || die "refusing invalid recovery status: $status"
    [[ -z "$snapshot" || "$snapshot" =~ ^[0-9]+$ ]] \
        || die "refusing invalid snapshot number: $snapshot"

    mkdir -p "$RECOVERY_DIR"
    chmod 700 "$RECOVERY_DIR"
    staged=$(mktemp "$RECOVERY_DIR/.latest.XXXXXX")
    printf '%s\n' \
        'schema=1' \
        "previous_revision=$previous" \
        "previous_version=$previous_version" \
        "target_revision=$target" \
        "target_version=$target_version" \
        "status=$status" \
        "snapper_pre=$snapshot" \
        > "$staged"
    chmod 600 "$staged"
    mv -f "$staged" "$RECOVERY_STATE"
}

recovery_read() {
    local requested="$1"
    local line key value found=

    [[ -r "$RECOVERY_STATE" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == *=* ]] || continue
        key=${line%%=*}
        value=${line#*=}
        if [[ "$key" == "$requested" ]]; then
            [[ -z "$found" ]] || return 1
            found=$value
        fi
    done < "$RECOVERY_STATE"
    [[ -n "$found" ]] || return 1
    printf '%s\n' "$found"
}

recovery_update_status() {
    local status="$1"
    local previous previous_version target target_version snapshot=

    previous=$(recovery_read previous_revision) || die "recovery state has no previous revision"
    previous_version=$(recovery_read previous_version) || die "recovery state has no previous version"
    target=$(recovery_read target_revision) || die "recovery state has no target revision"
    target_version=$(recovery_read target_version) || die "recovery state has no target version"
    snapshot=$(recovery_read snapper_pre 2>/dev/null || true)
    recovery_write "$previous" "$previous_version" "$target" "$target_version" "$status" "$snapshot"
}

restore_checkout() {
    local repository="$1"
    local revision="$2"

    validate_revision "$revision" || die "refusing invalid rollback revision: $revision"
    git -C "$repository" cat-file -e "$revision^{commit}" 2>/dev/null \
        || die "rollback revision is unavailable: ${revision:0:12}"
    [[ -z "$(git -C "$repository" status --porcelain)" ]] \
        || die "managed repository changed during the update; refusing automatic checkout recovery"
    git -C "$repository" reset --hard "$revision" > /dev/null
}

validate_install_plan() (
    local repository="$1"
    local capabilities config_file setup_config_file
    local -a repository_packages=()
    local -a aur_packages=()
    local -a provider_packages=()

    config_file=${XDG_CONFIG_HOME:-$HOME/.config}/blankweave/install.conf
    setup_config_file=${XDG_CONFIG_HOME:-$HOME/.config}/blankweave/setup.conf
    # shellcheck source=scripts/installer-config.sh
    source "$repository/scripts/installer-config.sh" || return
    # shellcheck source=scripts/setup-config.sh
    source "$repository/scripts/setup-config.sh" || return
    # shellcheck source=scripts/package-manifests.sh
    source "$repository/scripts/package-manifests.sh" || return
    # shellcheck source=scripts/hardware-capabilities.sh
    source "$repository/scripts/hardware-capabilities.sh" || return
    hardware_capabilities_detect || return
    capabilities=$(hardware_capabilities_list)
    installer_config_load "$config_file" "$capabilities" || return
    setup_config_load "$setup_config_file" || return
    resolve_package_manifests "$repository" "$capabilities" repository repository_packages || return
    resolve_package_manifests "$repository" "$capabilities" aur aur_packages || return
    resolve_package_manifests "$repository" "$capabilities" providers provider_packages || return

    printf 'Install plan: capabilities=%s profiles=%s packages=%d aur=%d providers=%d\n' \
        "${capabilities:-none}" "${INSTALLER_PROFILES[*]:-none}" \
        "${#repository_packages[@]}" "${#aur_packages[@]}" "${#provider_packages[@]}"
)

validate_target_plan() {
    local repository="$1"
    local target="$2"
    local target_tree
    local validation_status

    target_tree=$(mktemp -d /tmp/blankweave-update-plan.XXXXXX)
    if ! git -C "$repository" archive "$target" | tar -x -C "$target_tree"; then
        rm -rf -- "$target_tree"
        die "could not inspect the target revision"
    fi
    if validate_install_plan "$target_tree"; then
        validation_status=0
    else
        validation_status=$?
    fi
    rm -rf -- "$target_tree"
    (( validation_status == 0 )) || die "target revision has an invalid install plan"
}

create_pre_snapshot() {
    local previous="$1"
    local target="$2"
    local number

    SNAPSHOT_NUMBER=
    command -v snapper > /dev/null 2>&1 || return 0
    sudo snapper -c root get-config > /dev/null 2>&1 || return 0
    if number=$(sudo snapper -c root create --type pre --print-number \
        --description "blankweave update ${previous:0:12} -> ${target:0:12}"); then
        [[ "$number" =~ ^[0-9]+$ ]] || die "snapper returned an invalid snapshot number"
        SNAPSHOT_NUMBER=$number
        printf 'Created Snapper pre-update snapshot %s.\n' "$number"
    else
        die "could not create the configured Snapper pre-update snapshot"
    fi
}

create_post_snapshot() {
    local number="$1"
    local target="$2"

    [[ -n "$number" ]] || return 0
    if ! sudo snapper -c root create --type post --pre-number "$number" \
        --description "blankweave update ${target:0:12}" > /dev/null; then
        return 1
    fi
    printf 'Created the paired Snapper post-update snapshot.\n'
}

command_version() {
    local repository installed_revision installed_version installed_tag
    local repository_revision repository_version repository_tag floor

    repository=$(configured_repository)
    installed_revision=not-recorded
    installed_version=not-recorded
    installed_tag=not-recorded
    if [[ -r "$INSTALLED_REVISION_STATE" ]]; then
        IFS= read -r installed_revision < "$INSTALLED_REVISION_STATE"
        installed_revision=${installed_revision:0:12}
    fi
    if [[ -r $INSTALLED_VERSION_STATE ]]; then
        IFS= read -r installed_version < "$INSTALLED_VERSION_STATE"
    fi
    if [[ -r $INSTALLED_RELEASE_TAG_STATE ]]; then
        IFS= read -r installed_tag < "$INSTALLED_RELEASE_TAG_STATE"
    fi
    repository_revision=$(current_revision "$repository")
    repository_version=$(read_version)
    repository_tag=unreleased
    floor=unknown
    if [[ -d $repository/.git && -r $repository/scripts/release-version.sh ]]; then
        # shellcheck source=scripts/release-version.sh
        source "$repository/scripts/release-version.sh"
        local full_revision
        full_revision=$(git -C "$repository" rev-parse HEAD 2>/dev/null || true)
        if [[ -n $full_revision ]]; then
            repository_tag=$(blankweave_release_tag_at \
                "$repository" "$full_revision" 2>/dev/null || printf 'unreleased\n')
            floor=$(blankweave_release_floor_at \
                "$repository" "$full_revision" 2>/dev/null || printf 'unknown\n')
        fi
    fi

    printf 'blankweave %s (%s)\n' "$repository_version" "$repository_tag"
    printf 'installed:  %s / %s (%s)\n' \
        "$installed_version" "$installed_tag" "$installed_revision"
    printf 'repository: %s (%s)\n' "$repository_version" "$repository_revision"
    printf 'rollback floor: %s\n' "$floor"
}

# Folder colours and the boot splash need root, so a theme switch from a
# terminal finishes with a sudo step; the bar's picker cannot prompt and leaves
# them for `blankweave theme sync`.
command_theme_sync() {
    local repository

    repository=$(configured_repository)
    validate_repository "$repository"
    if [[ ! -t 0 ]]; then
        printf 'Folder colours and boot splash need a terminal: run blankweave theme sync\n' >&2
        return 0
    fi
    printf 'Applying folder colours and boot splash (sudo)...\n'
    sudo "$repository/scripts/theme-system.sh" "$HOME" "${XDG_CONFIG_HOME:-$HOME/.config}"
}

command_theme() {
    local script=$BLANKWEAVE_DATA_DIR/shell/theme-apply.sh

    require_normal_user
    [[ -x "$script" ]] || die "theme support is not deployed yet; run: blankweave update"
    case "${1:-}" in
        set)
            "$script" "$@"
            command_theme_sync
            ;;
        sync)
            [[ $# -eq 1 ]] || die "sync does not accept arguments"
            command_theme_sync
            ;;
        *)
            exec "$script" "$@"
            ;;
    esac
}

command_webapp() {
    local script=$BLANKWEAVE_DATA_DIR/shell/webapp.sh

    require_normal_user
    [[ -x "$script" ]] || die "web app support is not deployed yet; run: blankweave update"
    exec "$script" "$@"
}

command_doctor() {
    local repository

    repository=$(configured_repository)
    validate_repository "$repository"
    exec "$repository/scripts/doctor.sh" "$repository" "$@"
}

command_setup() {
    local repository

    repository=$(configured_repository)
    validate_repository "$repository"
    if [[ ${1:-} != --help && ${1:-} != -h ]]; then
        require_normal_user
    fi
    exec "$repository/scripts/setup.sh" "$@"
}

command_update() {
    local repository branch mode=apply current target current_version target_version
    local current_tag target_tag rollback_floor commit_count update_log doctor_script apply_status
    local SNAPSHOT_NUMBER=

    case "${1:-}" in
        '') ;;
        --check) mode=check ;;
        --dry-run) mode=dry-run ;;
        --help|-h)
            cat <<'EOF'
Usage: blankweave update [--check|--dry-run]

  --check    Fetch and report whether a tagged update is available.
  --dry-run  Validate the tagged update and print its install plan without applying it.
EOF
            return 0
            ;;
        *) die "update accepts only --check or --dry-run" ;;
    esac
    (( $# <= 1 )) || die "update accepts only one option"

    require_normal_user
    repository=$(configured_repository)
    validate_repository "$repository"

    branch=$(git -C "$repository" branch --show-current)
    [[ $branch == main ]] || die "managed repository must be on main, found: ${branch:-detached HEAD}"
    [[ -z "$(git -C "$repository" status --porcelain)" ]] \
        || die "managed repository has local changes; refusing to update"

    printf 'Fetching Blankweave releases...\n'
    git -C "$repository" fetch --prune --tags origin main
    git -C "$repository" merge-base --is-ancestor HEAD origin/main \
        || die "origin/main is not a fast-forward of the local checkout"
    current=$(git -C "$repository" rev-parse HEAD)
    target=$(git -C "$repository" rev-parse origin/main)

    # shellcheck source=scripts/release-version.sh
    source "$repository/scripts/release-version.sh"
    current_version=$(blankweave_release_version_at "$repository" "$current") \
        || die "current checkout has an invalid VERSION"
    current_tag=$(blankweave_release_tag_at "$repository" "$current") \
        || die "current checkout is not an annotated release matching VERSION"

    if [[ $current == "$target" ]]; then
        printf 'Blankweave %s (%s) is already up to date at %s.\n' \
            "$current_version" "$current_tag" "${current:0:12}"
        return 0
    fi

    target_version=$(blankweave_release_version_at "$repository" "$target") \
        || die "target revision has an invalid VERSION"
    target_tag=$(blankweave_release_tag_at "$repository" "$target") \
        || die "target revision is not an annotated release matching VERSION"
    blankweave_release_version_greater "$target_version" "$current_version" \
        || die "target release must advance beyond $current_version (found $target_version)"
    rollback_floor=$(blankweave_release_floor_at "$repository" "$target") \
        || die "target revision has an invalid MIN_ROLLBACK_VERSION"
    blankweave_release_version_greater_or_equal "$current_version" "$rollback_floor" \
        || die "target requires rollback floor $rollback_floor, but current is $current_version"

    commit_count=$(git -C "$repository" rev-list --count "$current..$target")
    printf '%s update(s) available: %s (%s) -> %s (%s)\n' \
        "$commit_count" "$current_tag" "${current:0:12}" \
        "$target_tag" "${target:0:12}"
    git -C "$repository" log --oneline --no-decorate "$current..$target"

    if [[ $mode == check ]]; then
        return 0
    fi

    validate_target_plan "$repository" "$target"
    [[ ! -e /var/lib/pacman/db.lck ]] \
        || die "pacman is already running (/var/lib/pacman/db.lck exists)"

    if [[ $mode == dry-run ]]; then
        printf 'Dry run complete; the managed checkout and system were not changed.\n'
        return 0
    fi

    printf 'Validating sudo before changing the checkout...\n'
    sudo -v
    recovery_write "$current" "$current_version" "$target" "$target_version" prepared
    doctor_script=$repository/scripts/doctor.sh
    if ! "$doctor_script" "$repository" --report > "$RECOVERY_DIR/preflight-report.txt"; then
        printf 'Warning: pre-update doctor found existing failures; its report was saved for comparison.\n' >&2
    fi
    chmod 600 "$RECOVERY_DIR/preflight-report.txt"

    create_pre_snapshot "$current" "$target"
    recovery_write "$current" "$current_version" "$target" "$target_version" prepared "$SNAPSHOT_NUMBER"
    git -C "$repository" merge --ff-only origin/main
    recovery_update_status applying

    update_log=$RECOVERY_DIR/update.log
    if apply_repository "$repository" 2>&1 | tee "$update_log"; then
        chmod 600 "$update_log"
    else
        apply_status=${PIPESTATUS[0]}
        chmod 600 "$update_log"
        recovery_update_status apply-failed
        restore_checkout "$repository" "$current"
        die "update apply failed with status $apply_status; checkout restored to ${current:0:12}. Run blankweave rollback to reconverge managed configuration"
    fi

    if ! create_post_snapshot "$SNAPSHOT_NUMBER" "$target"; then
        recovery_update_status snapshot-post-failed
        die "update applied, but the Snapper post-update snapshot failed; the pre-update snapshot remains available"
    fi
    doctor_script=$repository/scripts/doctor.sh
    if ! "$doctor_script" "$repository" --report > "$RECOVERY_DIR/postflight-report.txt"; then
        chmod 600 "$RECOVERY_DIR/postflight-report.txt"
        recovery_update_status degraded
        printf 'Update applied, but post-update health checks failed.\n' >&2
        printf 'Review %s or run blankweave rollback.\n' "$RECOVERY_DIR/postflight-report.txt" >&2
        return 1
    fi
    chmod 600 "$RECOVERY_DIR/postflight-report.txt"
    recovery_update_status complete
    printf 'Blankweave %s update complete. Recovery release: %s (%s)\n' \
        "$target_tag" "$current_tag" "${current:0:12}"
}

command_rollback() {
    local repository branch previous previous_version target target_version status current
    local rollback_floor rollback_log rollback_status snapshot=

    case "${1:-}" in
        '') ;;
        --help|-h)
            cat <<'EOF'
Usage: blankweave rollback

Restore the previous Blankweave revision and reconverge managed configuration.
Packages and completed one-time migrations are not reversed. If a Snapper
pre-update snapshot was recorded, its number is shown for manual system recovery.
Rollback never crosses the release floor recorded by the applied update.
EOF
            return 0
            ;;
        *) die "rollback does not accept arguments" ;;
    esac
    (( $# <= 1 )) || die "rollback does not accept arguments"

    require_normal_user
    repository=$(configured_repository)
    validate_repository "$repository"
    # shellcheck source=scripts/release-version.sh
    source "$repository/scripts/release-version.sh"
    branch=$(git -C "$repository" branch --show-current)
    [[ "$branch" == main ]] || die "managed repository must be on main, found: ${branch:-detached HEAD}"
    [[ -z "$(git -C "$repository" status --porcelain)" ]] \
        || die "managed repository has local changes; refusing to roll back"

    if [[ ! -s $RECOVERY_STATE ]]; then
        die "no rollback point is recorded; updates initiated before v0.2.0 could not create one. The next tagged update will create one before applying changes"
    fi
    [[ $(recovery_read schema 2>/dev/null || true) == 1 ]] \
        || die "recovery metadata uses an unsupported schema"
    previous=$(recovery_read previous_revision) || die "no recovery revision is recorded"
    previous_version=$(recovery_read previous_version) || die "no recovery version is recorded"
    target=$(recovery_read target_revision) || die "recovery state has no target revision"
    target_version=$(recovery_read target_version) || die "recovery state has no target version"
    status=$(recovery_read status) || die "recovery state has no status"
    snapshot=$(recovery_read snapper_pre 2>/dev/null || true)
    validate_revision "$previous" || die "recorded recovery revision is invalid"
    validate_revision "$target" || die "recorded target revision is invalid"
    blankweave_release_version_valid "$previous_version" \
        || die "recorded recovery version is invalid"
    blankweave_release_version_valid "$target_version" \
        || die "recorded target version is invalid"
    [[ $(blankweave_release_tag_at "$repository" "$previous" 2>/dev/null || true) == "v$previous_version" ]] \
        || die "recorded recovery revision does not match tagged release v$previous_version"
    [[ $(blankweave_release_tag_at "$repository" "$target" 2>/dev/null || true) == "v$target_version" ]] \
        || die "recorded target revision does not match tagged release v$target_version"
    rollback_floor=$(blankweave_release_floor_at "$repository" "$target") \
        || die "recorded target has an invalid rollback floor"
    blankweave_release_version_greater_or_equal "$previous_version" "$rollback_floor" \
        || die "refusing rollback to $previous_version; minimum supported release is $rollback_floor"
    current=$(git -C "$repository" rev-parse HEAD)

    if [[ "$current" != "$target" && "$current" != "$previous" ]]; then
        die "checkout ${current:0:12} does not match the recorded update; refusing to roll back"
    fi
    if [[ "$status" == rolled-back && "$current" == "$previous" ]]; then
        printf 'Blankweave is already rolled back to %s (%s).\n' \
            "$previous_version" "${previous:0:12}"
        return 0
    fi

    printf 'Rolling Blankweave back to %s (%s)...\n' \
        "$previous_version" "${previous:0:12}"
    sudo -v
    if [[ "$current" != "$previous" ]]; then
        restore_checkout "$repository" "$previous"
    fi
    recovery_update_status rolling-back
    rollback_log=$RECOVERY_DIR/rollback.log
    if apply_repository "$repository" 2>&1 | tee "$rollback_log"; then
        chmod 600 "$rollback_log"
        recovery_update_status rolled-back
        printf 'Managed configuration is restored to %s (%s).\n' \
            "$previous_version" "${previous:0:12}"
        printf 'Arch packages and completed one-time migrations were not reversed.\n'
        if [[ -n "$snapshot" ]]; then
            printf 'Snapper pre-update snapshot available for manual recovery: %s\n' "$snapshot"
        fi
    else
        rollback_status=${PIPESTATUS[0]}
        chmod 600 "$rollback_log"
        recovery_update_status rollback-failed
        die "rollback apply failed with status $rollback_status; checkout remains at ${previous:0:12} for recovery"
    fi
}

print_help() {
    cat <<'EOF'
Usage: blankweave <command>

Commands:
  version   Show the CLI version and installed/repository revisions
  setup     Guide first-install choices; use --non-interactive with saved configs
  update    Check, preview, or safely apply a fast-forward update
  rollback  Restore the previous Blankweave revision and managed configuration
  doctor    Run read-only health checks; add --report for shareable diagnostics
  theme     Manage the desktop theme: list, status, set <id>, mode <dark|light>, toggle, sync
  webapp    Manage Helium web apps: list, install <name> <url> <icon>, remove <name>, sync
  help      Show this help
EOF
}

main() {
    local command=${1:-help}
    shift || true

    case "$command" in
        version|--version|-V)
            [[ $# -eq 0 ]] || die "version does not accept arguments"
            command_version
            ;;
        update)
            command_update "$@"
            ;;
        setup)
            command_setup "$@"
            ;;
        rollback)
            command_rollback "$@"
            ;;
        doctor)
            command_doctor "$@"
            ;;
        theme)
            command_theme "$@"
            ;;
        webapp)
            command_webapp "$@"
            ;;
        help|--help|-h)
            [[ $# -eq 0 ]] || die "help does not accept arguments"
            print_help
            ;;
        _apply)
            [[ $# -eq 1 ]] || die "internal apply requires a repository path"
            apply_repository "$1"
            ;;
        *)
            printf '%s: unknown command: %s\n\n' "$PROGRAM_NAME" "$command" >&2
            print_help >&2
            exit 2
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi

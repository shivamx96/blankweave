#!/usr/bin/env bash

set -euo pipefail

PROGRAM_NAME=blankweave
# Both names are accepted until the GitHub repository is renamed; GitHub
# redirects the old one afterwards, so existing checkouts keep working.
EXPECTED_REMOTES=(
    https://github.com/shivamx96/hyprarch.git
    git@github.com:shivamx96/hyprarch.git
    https://github.com/shivamx96/blankweave.git
    git@github.com:shivamx96/blankweave.git
)
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
BLANKWEAVE_DATA_DIR=$HOME/.local/share/blankweave
BLANKWEAVE_STATE_DIR=$STATE_HOME/blankweave
REPOSITORY_STATE=$BLANKWEAVE_STATE_DIR/repository
INSTALLED_REVISION_STATE=$BLANKWEAVE_STATE_DIR/installed-revision

die() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

script_repository() {
    local script_dir candidate

    script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    candidate=$(cd -- "$script_dir/.." && pwd)
    if [[ -f "$candidate/install.sh" && -f "$candidate/VERSION" ]]; then
        printf '%s\n' "$candidate"
    fi
}

configured_repository() {
    local repository

    if repository=$(script_repository) && [[ -n "$repository" ]]; then
        printf '%s\n' "$repository"
    elif [[ -r "$REPOSITORY_STATE" ]]; then
        IFS= read -r repository < "$REPOSITORY_STATE"
        printf '%s\n' "$repository"
    else
        printf '%s\n' "$BLANKWEAVE_DATA_DIR/repository"
    fi
}

require_normal_user() {
    if (( EUID == 0 )); then
        die "run this command as your normal user; it will request sudo when required"
    fi
}

validate_repository() {
    local repository="$1"
    local remote

    [[ -d "$repository/.git" ]] || die "managed repository not found at $repository"
    [[ -f "$repository/install.sh" ]] || die "repository is missing install.sh"
    [[ -x "$repository/bin/blankweave" ]] || die "repository is missing the blankweave command"

    remote=$(git -C "$repository" remote get-url origin 2>/dev/null) \
        || die "repository has no origin remote"
    local expected accepted=false
    for expected in "${EXPECTED_REMOTES[@]}"; do
        [[ "$remote" == "$expected" ]] && accepted=true
    done
    [[ "$accepted" == true ]] || die "refusing unexpected origin remote: $remote"
}

current_revision() {
    git -C "$1" rev-parse --short=12 HEAD 2>/dev/null || printf 'unknown\n'
}

read_version() {
    local source_repository version_file

    if source_repository=$(script_repository) && [[ -r "$source_repository/VERSION" ]]; then
        version_file=$source_repository/VERSION
    elif [[ -r "$BLANKWEAVE_DATA_DIR/VERSION" ]]; then
        version_file=$BLANKWEAVE_DATA_DIR/VERSION
    else
        printf 'unknown\n'
        return
    fi

    head -n 1 "$version_file"
}

apply_repository() {
    local repository="$1"

    require_normal_user
    validate_repository "$repository"
    "$repository/install.sh"
}

command_version() {
    local repository installed_revision repository_revision

    repository=$(configured_repository)
    installed_revision=not-recorded
    if [[ -r "$INSTALLED_REVISION_STATE" ]]; then
        IFS= read -r installed_revision < "$INSTALLED_REVISION_STATE"
        installed_revision=${installed_revision:0:12}
    fi
    repository_revision=$(current_revision "$repository")

    printf 'blankweave %s\n' "$(read_version)"
    printf 'installed:  %s\n' "$installed_revision"
    printf 'repository: %s\n' "$repository_revision"
}

# Folder colours and the boot splash need root, so a theme switch from a
# terminal finishes with a sudo step; the bar's picker cannot prompt and leaves
# them for `blankweave theme sync`.
command_theme_sync() {
    local repository

    repository=$(configured_repository)
    validate_repository "$repository"
    if [[ ! -t 0 ]]; then
        printf 'Folder colours and boot splash need a terminal: run blankweave theme sync\n' >&2
        return 0
    fi
    printf 'Applying folder colours and boot splash (sudo)...\n'
    sudo "$repository/scripts/theme-system.sh" "$HOME" "${XDG_CONFIG_HOME:-$HOME/.config}"
}

command_theme() {
    local script=$BLANKWEAVE_DATA_DIR/shell/theme-apply.sh

    require_normal_user
    [[ -x "$script" ]] || die "theme support is not deployed yet; run: blankweave update"
    case "${1:-}" in
        set)
            "$script" "$@"
            command_theme_sync
            ;;
        sync)
            [[ $# -eq 1 ]] || die "sync does not accept arguments"
            command_theme_sync
            ;;
        *)
            exec "$script" "$@"
            ;;
    esac
}

command_update() {
    local repository branch

    require_normal_user
    repository=$(configured_repository)
    validate_repository "$repository"

    branch=$(git -C "$repository" branch --show-current)
    [[ "$branch" == main ]] || die "managed repository must be on main, found: ${branch:-detached HEAD}"
    [[ -z "$(git -C "$repository" status --porcelain)" ]] \
        || die "managed repository has local changes; refusing to update"

    printf 'Fetching Blankweave updates...\n'
    git -C "$repository" fetch --prune origin main
    git -C "$repository" merge-base --is-ancestor HEAD origin/main \
        || die "origin/main is not a fast-forward of the local checkout"
    git -C "$repository" merge --ff-only origin/main

    exec "$repository/bin/blankweave" _apply "$repository"
}

print_help() {
    cat <<'EOF'
Usage: blankweave <command>

Commands:
  version   Show the CLI version and installed/repository revisions
  update    Fast-forward the managed repository and apply the update
  theme     Manage the desktop theme: list, status, set <id>, mode <dark|light>, toggle, sync
  help      Show this help
EOF
}

main() {
    local command=${1:-help}
    shift || true

    case "$command" in
        version|--version|-V)
            [[ $# -eq 0 ]] || die "version does not accept arguments"
            command_version
            ;;
        update)
            [[ $# -eq 0 ]] || die "update does not accept arguments"
            command_update
            ;;
        theme)
            command_theme "$@"
            ;;
        help|--help|-h)
            [[ $# -eq 0 ]] || die "help does not accept arguments"
            print_help
            ;;
        _apply)
            [[ $# -eq 1 ]] || die "internal apply requires a repository path"
            apply_repository "$1"
            ;;
        *)
            printf '%s: unknown command: %s\n\n' "$PROGRAM_NAME" "$command" >&2
            print_help >&2
            exit 2
            ;;
    esac
}

main "$@"
